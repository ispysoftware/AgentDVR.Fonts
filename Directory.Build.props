<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Agent DVR fork (branch "agent", from upstream tag v1.0.1 - the last Apache-2.0 release).
    Self-contained build: upstream's shared-infrastructure props (StyleCop, strong naming,
    artifacts/ output tree, extra restore feeds) are not imported, and the few shared
    sources it provided live in src/SixLabors.Fonts/SharedInfrastructure.
  -->

  <PropertyGroup>
    <!-- Same language as Agent (the net10 default). Upstream's netstandard feature switches and their
         polyfills are gone: the code targets net10.0 only. -->
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NeutralLanguage>en</NeutralLanguage>
    <DebugType>portable</DebugType>
  </PropertyGroup>

</Project>

<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Agent DVR fork (branch "agent", from upstream tag v1.0.1 - the last Apache-2.0 release).
    Self-contained build: upstream's shared-infrastructure props (StyleCop, strong naming,
    artifacts/ output tree, extra restore feeds) are not imported, and the few shared
    sources it provided live in src/SixLabors.Fonts/SharedInfrastructure.
  -->

  <PropertyGroup>
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NeutralLanguage>en</NeutralLanguage>
    <DebugType>portable</DebugType>
    <!-- Upstream's per-framework feature switches, as set for netcoreapp3.1 and later. -->
    <DefineConstants>$(DefineConstants);SUPPORTS_MATHF;SUPPORTS_HASHCODE;SUPPORTS_EXTENDED_INTRINSICS;SUPPORTS_SPAN_STREAM;SUPPORTS_ENCODING_STRING;SUPPORTS_RUNTIME_INTRINSICS;SUPPORTS_CODECOVERAGE;SUPPORTS_HOTPATH;SUPPORTS_CREATESPAN;SUPPORTS_BITOPERATIONS;NULLABLE_ATTRIBUTES</DefineConstants>
  </PropertyGroup>

</Project>
